// Prisma schema for the IPAM (IP Address Management) platform.
// Uses the Supabase-hosted PostgreSQL database.
// Run `npx prisma generate` after editing this file.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum NetworkStatus {
  ACTIVE
  RESERVED
  ARCHIVED

  @@map("network_status")
}

enum IpStatus {
  AVAILABLE
  ASSIGNED
  RESERVED
  BLOCKED

  @@map("ip_status")
}

enum DeviceType {
  COMPUTER           // Компьютер
  PRINTER_MFU        // Принтер, МФУ
  SERVER             // Сервер
  NETWORK_EQUIPMENT  // Сетевое оборудование
  VIRTUAL_SERVER     // Виртуальный сервер
  APPLICATION        // Приложение
  MICROSERVICE       // Микросервис
  CAMERA             // Видеокамера
  UPS                // ИБП
  POWER_CLIMATE      // Энергетика и климатехника
  OTHER              // Прочее

  @@map("device_type")
}

enum Branch {
  DIT                   // ДИТ
  DRB                   // ДРБ
  ODS                    // ОДС
  DKB                    // ДКБ
  SERVICE_FACTORY        // Сервисная фабрика
  CORPORATE_UNIVERSITY   // Корпоративный университет
  DCB                     // ДЦБ
  DPB                     // ДПБ (Дирекция Производственной Безопасности)
  DUP                     // ДУП (Дирекция Управления Проектами)
  DTK                     // ДТК (Дирекция Телеком Комплект)
  PROFKOM                 // Профком
  KT_CLOUD_LAB             // ТОО KT Cloud Lab

  @@map("branch")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT

  @@map("audit_action")
}

// RoleScope separates roles that apply to the IPAM branch of the app from
// roles that apply to the Паспорта (IT-object passports) branch. A user can
// hold one role of each scope independently — see User.roleId / passportRoleId
// below, and docs/it-passports-design.md section 2 for the reasoning.
enum RoleScope {
  IPAM
  PASSPORT

  @@map("role_scope")
}

// Field types available in the passport form builder. TABLE is a repeating
// group of rows (see TableFieldRow) — its own column layout is stored as
// JSON on FieldDefinition.tableColumns rather than as a separate model,
// since it's small, admin-managed schema metadata, not per-instance data.
enum FieldType {
  TEXT
  LONG_TEXT
  DATE
  BOOLEAN
  LINK
  SELECT
  TABLE
  // Full relational link to a real IpAddress row (see
  // docs/it-passports-design.md section 6.3, "вариант 1") — unlike TEXT +
  // validateAsIp (a soft, advisory check on a plain-text value), a field of
  // this type can only ever hold the id of a real IpAddress: the value
  // stored in ObjectInstance.values is that id, and FieldIpAddressValue
  // mirrors it in a real relational row with an actual foreign key, so
  // deleting an IpAddress that's referenced by a passport is rejected at
  // the database level (see FieldIpAddressValue.ipAddress below), not just
  // advised against.
  IP_REFERENCE
  // Generalization of IP_REFERENCE (28 August 2026, CMDB phase 2 — see
  // it-passports-design.md section 8) to any object in the CMDB, not just
  // IpAddress: a field of this type holds a hard link to either a Location
  // tree node (containment — "this server lives in this rack") or another
  // passport (dependency — "this application runs on this server"), never
  // free text. Which of the two — and, for a passport target, which
  // ObjectType it must be — is fixed per field by the admin (see
  // FieldDefinition.referenceTargetKind/referenceObjectTypeId below), not
  // chosen per value. The value stored in ObjectInstance.values is still
  // just the target's id (same "one JSON blob" pattern as every other
  // field type); FieldObjectReferenceValue is the real relational mirror,
  // exactly the way FieldIpAddressValue backs IP_REFERENCE.
  OBJECT_REFERENCE
  // Computed composite equipment identifier (28 August 2026, CMDB phase 3
  // — see it-passports-design.md section 8.1 item 3), per the Kazakhtelecom
  // naming standard (ДИТ/И-05-28.2-16). Never entered by hand: the value —
  // e.g. "alma-B2S1A1-cs-3" — is assembled server-side once, at the first
  // save that has a rack to work with, from (a) the rack this passport
  // lives in, read off another field on the *same* ObjectType that must be
  // OBJECT_REFERENCE targeting LOCATION (see
  // FieldDefinition.autoIdentifierRackFieldKey), (b) a fixed equipment-type
  // code the admin chose once in the constructor (see
  // FieldDefinition.autoIdentifierEquipmentTypeCodeId, EquipmentTypeCode),
  // and (c) the next free sequential number for that (rack, code) pair.
  // Deliberately scoped to top-level fields only, not TABLE columns — a
  // table row rarely has its own rack, so extending this is deferred until
  // an actual need appears. This first pass also only covers rack-anchored
  // equipment (Table 2 of the standard); cluster/VM/patch-cord identifier
  // formats are a separate future phase, not this field type. The computed
  // string is still stored in ObjectInstance.values under the field's key
  // like every other field type (generic read paths keep working), but
  // FieldAutoIdentifierValue is the source of truth for uniqueness.
  AUTO_IDENTIFIER
  // Physical position inside a rack (31 August 2026, CMDB phase 5 — see
  // it-passports-design.md section 8.8), used by the rack-elevation
  // visualization. Entered manually by the user (not computed, unlike
  // AUTO_IDENTIFIER — equipment height varies within one ObjectType, so
  // there's nothing fixed to derive it from), stored in ObjectInstance.
  // values as the plain string "{startUnit}:{sizeUnits}" (e.g. "12:2"),
  // like every other field type — no relational mirror table, this is
  // advisory data: the rack-elevation page detects and flags overlapping
  // ranges/over-capacity directly on the picture (same scan-and-report
  // pattern as /data-integrity) rather than blocking the save, so a
  // typo'd position doesn't lock up the passport form the way an
  // AUTO_IDENTIFIER collision would. Requires a sibling OBJECT_REFERENCE
  // field targeting LOCATION on the same ObjectType to know which rack the
  // position is relative to (FieldDefinition.rackPositionRackFieldKey),
  // same "sibling field by key" pattern as
  // FieldDefinition.autoIdentifierRackFieldKey. Deliberately scoped to
  // top-level fields only, not TABLE columns, same reasoning as
  // AUTO_IDENTIFIER above.
  RACK_POSITION

  @@map("field_type")
}

// Which kind of CMDB object an OBJECT_REFERENCE field (or TABLE column of
// that type) points to — set once per field by the admin, not per value.
// LOCATION covers containment ("in which rack"); OBJECT_TYPE covers
// dependency on another passport, scoped to one specific ObjectType via
// FieldDefinition.referenceObjectTypeId (e.g. "must be a Server passport").
enum ReferenceTargetKind {
  LOCATION
  OBJECT_TYPE

  @@map("reference_target_kind")
}

// Which kind of relationship an OBJECT_REFERENCE field (or TABLE column of
// that type) represents when it targets another passport (referenceTargetKind
// = OBJECT_TYPE) — the ITIL/CMDB five-type taxonomy already discussed in
// it-passports-design.md sections 8.0/6.1, made explicit and machine-usable
// (1 September 2026, CMDB phase 6) so the passport card can show reciprocal
// links grouped by meaning, and so the impact-analysis page
// (getImpactAnalysis in passports/actions.ts) knows which links propagate a
// failure (DEPENDENCY) and which don't (ASSOCIATION/OWNERSHIP/CONTAINMENT
// between two passports — rare; the common containment case, into the
// location tree, doesn't use this enum at all, see below).
//
// Deliberately NOT used for referenceTargetKind = LOCATION fields/columns —
// a link into the location tree is always containment by construction (a
// passport pointing at a Location node "lives in" that node), so there's
// nothing for the admin to choose there; FieldDefinition.relationshipType
// (and the tableColumns JSON equivalent) stays null for those.
enum RelationshipType {
  CONTAINMENT // «входит в состав» — passport-to-passport containment (e.g. a VM's host chassis, modeled as a passport rather than a rack); most containment in this app is OBJECT_REFERENCE -> LOCATION instead, which never sets this enum
  DEPENDENCY // «зависит от» — the referencing passport can't function without the target; this is the only edge type getImpactAnalysis traverses transitively
  ASSOCIATION // «связан с» — a looser link with no implied failure propagation (e.g. a patch cord to whatever equipment is on the other end); the default existing OBJECT_TYPE-target fields were backfilled to when this column was added
  OWNERSHIP // «принадлежит / отвечает за» — an organizational link, not a technical one
  IMPACT // «влияет на» — an explicit, admin-asserted direct impact edge; shown on the impact-analysis page as a direct link but, unlike DEPENDENCY, not followed transitively (see that page's doc comment for why)

  @@map("relationship_type")
}

// CI lifecycle status (2 September 2026, CMDB phase 7 — see
// it-passports-design.md section 8.11). Deliberately a small, fixed set
// matching the three states the user actually named when this phase was
// scoped, not a configurable-per-type status workflow — that would be a
// much bigger feature (custom statuses, allowed transitions per type) that
// nothing so far has asked for. No "PLANNED"/"in stock" state: passports in
// this app are created once the object already physically exists (see
// section 8.0), so a not-yet-deployed CI simply isn't a passport yet.
enum ObjectInstanceStatus {
  IN_USE // «в эксплуатации» — default for both new and (via migration backfill) every pre-existing passport
  UNDER_MAINTENANCE // «на обслуживании»
  DECOMMISSIONED // «выведен из эксплуатации» — stays in the CMDB (never hidden or deleted) so history and existing references remain intact; just visually and filterably distinct

  @@map("object_instance_status")
}

// ─────────────────────────────────────────────
// Role
// ─────────────────────────────────────────────

model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @unique
  description String?
  scope       RoleScope @default(IPAM)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  users             User[]            @relation("IpamRole")
  passportUsers     User[]            @relation("PassportRole")
  fieldVisibilities FieldVisibility[]

  @@index([scope])
  @@map("roles")
}

// ─────────────────────────────────────────────
// User
// ─────────────────────────────────────────────

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  fullName       String?  @map("full_name")
  isActive       Boolean  @default(true) @map("is_active")
  roleId         String?  @map("role_id") @db.Uuid
  passportRoleId String?  @map("passport_role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  role           Role?                       @relation("IpamRole", fields: [roleId], references: [id], onDelete: SetNull)
  passportRole   Role?                       @relation("PassportRole", fields: [passportRoleId], references: [id], onDelete: SetNull)
  auditLogs      AuditLog[]
  responsibleFor ObjectInstanceResponsible[]

  @@index([roleId])
  @@index([passportRoleId])
  @@map("users")
}

// Levels of the location hierarchy (see it-passports-design.md / roadmap.md,
// "CMDB: дерево локаций", 28 August 2026). Rows are deliberately NOT their
// own level — per the naming standard this project follows, a row is just a
// single-letter code carried on the rack itself (Location.rowCode below),
// not a container with its own children.
enum LocationKind {
  REGION // Широкая географическая группировка городов (опционально, не обязателен как родитель CITY)
  CITY // Город/посёлок — верхний уровень в старой плоской модели, код обычно 4 латинские буквы
  BUILDING // Здание
  ROOM // Помещение: кабинет, коридор, кабельная шахта, или ЦОД-зал (гермозона living одним уровнем ниже, см. ZONE)
  ZONE // Гермозона внутри ЦОД-помещения — где реально стоят стойки
  RACK // Коммутационный шкаф/стойка

  @@map("location_kind")
}

// ─────────────────────────────────────────────
// Location
// ─────────────────────────────────────────────
//
// A self-referencing tree: Region → City → Building → Room → Zone → Rack,
// modeled as one recursive table rather than one model per level (matching
// how Network already nests subnets under a parent Network, and how NetBox
// models Region/Site/Location/Rack — see the CMDB discussion in
// it-passports-design.md, 28 August 2026). Every row that existed before
// this hierarchy was added is a root (parentId null) of kind BUILDING —
// that's what the flat model already meant in practice (a site with an
// address that networks attach to), so no data migration was needed beyond
// backfilling that default.
//
// name/code used to be globally unique; they're now unique only among
// siblings (same parentId), enforced in app code (locations/actions.ts),
// not as a DB constraint — see that file's createLocation/updateLocation
// for why (Postgres treats NULL parentId as distinct from itself, so a
// plain composite unique index wouldn't actually constrain root-level
// siblings). Root-level codes in particular stay effectively unique the
// same way they always were, which matters because networks/csv-actions.ts
// still resolves a network's location by root-level code text.
model Location {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  kind        LocationKind @default(BUILDING)
  name        String
  code        String
  rowCode     String?      @map("row_code") // ряд — только для RACK; см. комментарий у LocationKind
  // Вместимость стойки в юнитах (U) — только для RACK, используется
  // визуализацией раскладки стойки (CMDB фаза 5, 31 августа 2026, см.
  // it-passports-design.md раздел 8.8). NULL, пока админ не указал —
  // страница раскладки в этом случае просит заполнить, ничего не рисует
  // наугад.
  rackUnits   Int?         @map("rack_units")
  address     String?
  city        String?
  country     String?
  latitude    Float?
  longitude   Float?
  description String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[] @relation("LocationHierarchy")
  networks Network[]
  // OBJECT_REFERENCE fields/table-columns (target kind LOCATION) currently
  // pointing at this node — see FieldObjectReferenceValue/
  // TableCellObjectReferenceValue. onDelete: Restrict on those tables'
  // targetLocation is what actually stops an in-use node from being
  // deleted; deleteLocation checks these proactively for a friendly error.
  referencedByFields     FieldObjectReferenceValue[]
  referencedByTableCells TableCellObjectReferenceValue[]
  // AUTO_IDENTIFIER values (28 August 2026, CMDB phase 3) generated using
  // this node as the rack — onDelete: Restrict on FieldAutoIdentifierValue.
  // targetLocation is what actually stops a rack from being deleted once
  // an identifier has been generated from it; deleteLocation checks this
  // proactively for a friendly error, same pattern as the two relations
  // above.
  autoIdentifierLinks    FieldAutoIdentifierValue[]

  @@index([parentId])
  @@map("locations")
}

// ─────────────────────────────────────────────
// Network
// A Network is any block of address space identified by CIDR. It can be
// nested arbitrarily deep inside another Network (parentId) — a top-level
// allocation (e.g. /16) and a subnet carved out of it (e.g. /24, /28, ...)
// are the same kind of entity, just at different levels of the same tree.
// ─────────────────────────────────────────────

model Network {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  cidr        String        @unique
  description String?
  vlanId      Int?          @map("vlan_id")
  status      NetworkStatus @default(ACTIVE)
  locationId  String?       @map("location_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  location    Location?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  parent      Network?    @relation("NetworkHierarchy", fields: [parentId], references: [id], onDelete: NoAction)
  children    Network[]   @relation("NetworkHierarchy")
  ipAddresses IpAddress[]

  @@index([locationId])
  @@index([status])
  @@index([parentId])
  @@map("networks")
}

// ─────────────────────────────────────────────
// IPAddress
// ─────────────────────────────────────────────

model IpAddress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  address     String   @unique
  hostname    String?
  macAddress  String?  @map("mac_address")
  status      IpStatus @default(AVAILABLE)
  description String?
  networkId   String   @map("network_id") @db.Uuid
  assignedAt  DateTime? @map("assigned_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Card fields added 25 August 2026 — all free text except deviceType,
  // which is a fixed, easy-to-extend enum (mirrors IpStatus). None of
  // these are required, so existing rows stay valid untouched.
  branch           Branch?     @map("branch")            // «Филиал»
  responsibleParty String?     @map("responsible_party") // «Ответственное подразделение/Пользователь»
  purpose          String?     @map("purpose")           // «Назначение»
  deviceType       DeviceType? @map("device_type")       // «Тип устройства»
  basis            String?     @map("basis")             // «Основание»

  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)
  // Passport fields of type IP_REFERENCE currently pointing at this
  // address — see FieldIpAddressValue. onDelete: Restrict there means
  // Postgres itself refuses to delete an IpAddress while any such row
  // exists (deleteIpAddress in app/(app)/ip-addresses/actions.ts checks
  // this proactively for a friendly error, but the DB constraint is the
  // actual guarantee).
  passportLinks FieldIpAddressValue[]
  // Same guarantee, one level down — table-column cells of type
  // IP_REFERENCE pointing at this address. See TableCellIpAddressValue
  // (26 August 2026, extending IP_REFERENCE from regular fields to
  // TABLE-field columns).
  tableCellLinks TableCellIpAddressValue[]

  @@index([networkId])
  @@index([status])
  @@map("ip_addresses")
}

// ─────────────────────────────────────────────
// AuditLog
// ─────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action    AuditAction
  entity    String
  entityId   String?     @map("entity_id")
  metadata  Json?
  userId    String?     @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════
// Паспорта ИТ-объектов (Паспорт КИС, Паспорт БД, ЦОД, ДГУ, ...)
//
// Design: docs/it-passports-design.md. Admins define arbitrary object
// types through a form builder (ObjectType + FieldDefinition) instead of
// each new passport kind needing its own tables/code. Ordinary field
// values live in ObjectInstance.values (jsonb) rather than a per-field EAV
// table — see the design doc, section 2, for the reasoning (JSONB beats
// EAV at this scale: single-row reads, native typing, ~3x less storage).
// ═══════════════════════════════════════════════════════════════════════

// ─────────────────────────────────────────────
// ObjectType — an admin-defined kind of IT-object passport.
// ─────────────────────────────────────────────

model ObjectType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fields    FieldDefinition[]
  instances ObjectInstance[]
  // FieldDefinitions elsewhere (on any ObjectType) whose OBJECT_REFERENCE
  // is configured to only accept passports of this type — config-level
  // only (which type a picker is scoped to), not a per-value link; see
  // FieldDefinition.referenceObjectType below. deleteObjectType checks
  // this so removing a type doesn't strand another type's field config.
  fieldsReferencingThisType FieldDefinition[] @relation("FieldReferenceTargetType")

  @@map("object_types")
}

// ─────────────────────────────────────────────
// FieldDefinition — one field inside an ObjectType, defined by the admin
// through the form builder.
// ─────────────────────────────────────────────

model FieldDefinition {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectTypeId String    @map("object_type_id") @db.Uuid
  sectionName  String?   @map("section_name")
  key          String
  label        String
  type         FieldType
  order        Int       @default(0)
  required     Boolean   @default(false)
  // When false, only the roles listed in `visibleRoles` may see this
  // field's value — everyone else has it filtered out server-side.
  visibleToAll Boolean   @default(true) @map("visible_to_all")
  // Column layout for TABLE-type fields only: [{ key, label, type }, ...].
  tableColumns Json?     @map("table_columns")
  // Fixed list of choices for SELECT-type fields only: string[] as JSON.
  options      Json?     @map("options")
  // Optional short guidance shown next to the field while filling a
  // passport (e.g. what format is expected, an example value) — separate
  // from `label` so labels can stay short while longer explanations live
  // here instead of being crammed into the label in parentheses.
  helpText     String?   @map("help_text")
  // Only meaningful for TEXT fields the admin has marked as holding an IP
  // address (e.g. "Хост-IP"). This is deliberately a soft, advisory check,
  // not a real link: the value is still plain text in `values` jsonb, not a
  // foreign key to IpAddress — see docs/it-passports-design.md section 6.3
  // ("мягкая валидация") for why a full IP_REFERENCE field type was
  // intentionally deferred in favor of this lighter first step. The fill
  // form uses this flag to look up whether the typed value matches an
  // existing IpAddress and shows a non-blocking warning if it doesn't.
  validateAsIp Boolean   @default(false) @map("validate_as_ip")
  // Only meaningful for OBJECT_REFERENCE fields (28 August 2026, CMDB
  // phase 2) — which kind of object this field points to. See
  // ReferenceTargetKind and the FieldType.OBJECT_REFERENCE doc comment.
  referenceTargetKind   ReferenceTargetKind? @map("reference_target_kind")
  // Only meaningful when referenceTargetKind = OBJECT_TYPE: restricts the
  // picker (and the server-side validation) to passports of this one
  // ObjectType, e.g. a "Расположен на сервере" field on a VM's passport
  // type pointing only at Server passports. Left null for
  // referenceTargetKind = LOCATION, where any node in the tree is valid.
  referenceObjectTypeId String?              @map("reference_object_type_id") @db.Uuid
  // Only meaningful for AUTO_IDENTIFIER fields (phase 3) — the `key` of
  // another FieldDefinition on the *same* ObjectType that must be
  // OBJECT_REFERENCE with referenceTargetKind = LOCATION. That field
  // supplies the rack this identifier is anchored to. Stored as a plain
  // key, not a FK id, because it points at a sibling row of the same table
  // being defined/edited in the same request (create/update run together
  // in one call) — see validateAutoIdentifierConfig in
  // object-types/actions.ts for the existence/type check done before
  // create/update, and auto-identifier-utils.ts for how it's resolved at
  // generation time.
  autoIdentifierRackFieldKey        String?  @map("auto_identifier_rack_field_key")
  // Only meaningful for AUTO_IDENTIFIER fields — the fixed equipment-type
  // code (e.g. "cs" = коммутатор) this field always generates identifiers
  // with, chosen once by the admin from EquipmentTypeCode. onDelete:
  // Restrict so a code can't be deleted while some field is configured to
  // use it (checked proactively in deleteEquipmentTypeCode).
  autoIdentifierEquipmentTypeCodeId String? @map("auto_identifier_equipment_type_code_id") @db.Uuid
  // Only meaningful for RACK_POSITION fields (phase 5) — same "sibling
  // field key, not FK id" pattern as autoIdentifierRackFieldKey above, and
  // for the same reason (points at a row of the same table being
  // defined/edited in the same request). See FieldType.RACK_POSITION doc
  // comment.
  rackPositionRackFieldKey          String? @map("rack_position_rack_field_key")
  // Only meaningful for OBJECT_REFERENCE fields with referenceTargetKind =
  // OBJECT_TYPE (passport-to-passport links) — see RelationshipType above.
  // Left null for referenceTargetKind = LOCATION fields (always containment,
  // not stored) and for every other field type.
  relationshipType RelationshipType? @map("relationship_type")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  objectType     ObjectType            @relation(fields: [objectTypeId], references: [id], onDelete: Cascade)
  // Config-level FK — restricts which passports an OBJECT_REFERENCE field
  // may point to. onDelete: Restrict so an ObjectType can't be deleted
  // while some other field is still configured to reference it (checked
  // proactively in deleteObjectType for a friendly error).
  referenceObjectType   ObjectType?              @relation("FieldReferenceTargetType", fields: [referenceObjectTypeId], references: [id], onDelete: Restrict)
  // Config-level FK for AUTO_IDENTIFIER fields — see
  // autoIdentifierEquipmentTypeCodeId above.
  autoIdentifierEquipmentTypeCode EquipmentTypeCode? @relation(fields: [autoIdentifierEquipmentTypeCodeId], references: [id], onDelete: Restrict)
  visibleRoles          FieldVisibility[]
  tableRows              TableFieldRow[]
  ipAddressLinks         FieldIpAddressValue[]
  objectReferenceLinks   FieldObjectReferenceValue[]
  autoIdentifierLinks    FieldAutoIdentifierValue[]

  @@unique([objectTypeId, key])
  @@index([objectTypeId])
  @@index([referenceObjectTypeId])
  @@index([autoIdentifierEquipmentTypeCodeId])
  @@map("field_definitions")
}

// ─────────────────────────────────────────────
// FieldIpAddressValue — the real relational backing for FieldType.
// IP_REFERENCE fields. One row per (passport, field) pair currently
// pointing at a real IpAddress. ObjectInstance.values still holds the
// IpAddress id under the field's key (same "one JSON blob" pattern as
// every other field type, so existing generic read paths keep working),
// but this table is the source of truth for referential integrity: the
// onDelete: Restrict on `ipAddress` is what actually stops an in-use
// address from being deleted, kept in sync transactionally by
// createPassport/updatePassport (app/(app)/passports/actions.ts) and by
// importPassportsCsv (csv-actions.ts) whenever an IP_REFERENCE field's
// value is written.
// ─────────────────────────────────────────────

model FieldIpAddressValue {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectInstanceId  String   @map("object_instance_id") @db.Uuid
  fieldDefinitionId String   @map("field_definition_id") @db.Uuid
  ipAddressId       String   @map("ip_address_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  objectInstance  ObjectInstance  @relation(fields: [objectInstanceId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  ipAddress       IpAddress       @relation(fields: [ipAddressId], references: [id], onDelete: Restrict)

  @@unique([objectInstanceId, fieldDefinitionId])
  @@index([ipAddressId])
  @@map("field_ip_address_values")
}

// ─────────────────────────────────────────────
// FieldObjectReferenceValue — the real relational backing for FieldType.
// OBJECT_REFERENCE fields (28 August 2026, CMDB phase 2 — generalizes
// FieldIpAddressValue above from IpAddress targets to any CMDB object).
// One row per (passport, field) pair, pointing at exactly one of
// targetLocation or targetObjectInstance — never both, never neither;
// which one is legal is fixed by the owning FieldDefinition's
// referenceTargetKind. Enforced at the database level by a CHECK
// constraint (hand-written in the migration — Prisma's schema language has
// no first-class way to express "exactly one of two nullable columns is
// set", so it isn't modeled here, only the columns and their FKs are).
// onDelete: Restrict on both target relations is what stops an in-use
// Location or passport from being deleted; the owning passport itself
// still cascades (deleting the referencing side, not the target, is always
// fine — see objectInstance below).
// ─────────────────────────────────────────────

model FieldObjectReferenceValue {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectInstanceId       String   @map("object_instance_id") @db.Uuid
  fieldDefinitionId      String   @map("field_definition_id") @db.Uuid
  targetLocationId       String?  @map("target_location_id") @db.Uuid
  targetObjectInstanceId String?  @map("target_object_instance_id") @db.Uuid
  // Denormalized copy of the owning FieldDefinition.relationshipType (1
  // September 2026, CMDB phase 6), written by syncFieldObjectReferenceLinks
  // at the same time as everything else in this row — same "delete then
  // recreate" sync, so it can never drift from the field's current config.
  // Kept here (not just joined at read time) so getImpactAnalysis can query
  // "every DEPENDENCY edge in the system" in one pass over this table, no
  // join to field_definitions needed. Always null when targetLocationId is
  // set (containment via the location tree doesn't use this enum — see
  // RelationshipType's doc comment).
  relationshipType       RelationshipType? @map("relationship_type")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // The passport this field belongs to (the referencing side) — cascades,
  // same as FieldIpAddressValue.objectInstance.
  objectInstance ObjectInstance @relation("FieldObjectReferenceOwner", fields: [objectInstanceId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  targetLocation       Location?       @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)
  // The passport being pointed at (the referenced side) — deliberately a
  // different relation name than objectInstance above, since one
  // ObjectInstance can appear on both sides of this table at once (it owns
  // its own OBJECT_REFERENCE fields, and other passports can point at it).
  targetObjectInstance ObjectInstance? @relation("FieldObjectReferenceTarget", fields: [targetObjectInstanceId], references: [id], onDelete: Restrict)

  @@unique([objectInstanceId, fieldDefinitionId])
  @@index([targetLocationId])
  @@index([targetObjectInstanceId])
  @@map("field_object_reference_values")
}

// ─────────────────────────────────────────────
// FieldVisibility — used only when FieldDefinition.visibleToAll = false;
// each row grants one (Passport-scope) role permission to see the field.
// ─────────────────────────────────────────────

model FieldVisibility {
  fieldDefinitionId String @map("field_definition_id") @db.Uuid
  roleId             String @map("role_id") @db.Uuid

  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([fieldDefinitionId, roleId])
  @@map("field_visibilities")
}

// ─────────────────────────────────────────────
// ObjectInstance — one filled-in passport (e.g. "Паспорт КИС — Биллинг").
// Ordinary field values live in `values`, keyed by FieldDefinition.key.
// ─────────────────────────────────────────────

model ObjectInstance {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectTypeId String               @map("object_type_id") @db.Uuid
  name         String
  status       ObjectInstanceStatus @default(IN_USE)
  values       Json                 @default("{}")
  createdById  String?              @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  objectType   ObjectType                  @relation(fields: [objectTypeId], references: [id], onDelete: Restrict)
  responsible  ObjectInstanceResponsible[]
  tableRows    TableFieldRow[]
  ipAddressLinks FieldIpAddressValue[]
  // This passport's own OBJECT_REFERENCE field values (the referencing
  // side) — cascades when this passport is deleted, same as ipAddressLinks.
  objectReferenceLinks FieldObjectReferenceValue[] @relation("FieldObjectReferenceOwner")
  // Other passports' OBJECT_REFERENCE fields/table-columns currently
  // pointing AT this passport (the referenced side) — onDelete: Restrict
  // on those tables' targetObjectInstance is what stops this passport from
  // being deleted while still referenced; deletePassport checks these
  // proactively for a friendly error, same pattern as deleteIpAddress.
  referencedByFields     FieldObjectReferenceValue[]     @relation("FieldObjectReferenceTarget")
  referencedByTableCells TableCellObjectReferenceValue[] @relation("TableCellObjectReferenceTarget")
  // This passport's own AUTO_IDENTIFIER field values (28 August 2026, CMDB
  // phase 3) — cascades when this passport is deleted, same as
  // objectReferenceLinks above (losing the passport also frees its
  // reserved (rack, code, seq) slot for reuse, which is fine — the
  // identifier only ever needs to be unique among *currently existing*
  // equipment).
  autoIdentifierLinks    FieldAutoIdentifierValue[]

  @@index([objectTypeId])
  @@index([status])
  @@map("object_instances")
}

// ─────────────────────────────────────────────
// ObjectInstanceResponsible — who is personally responsible for a given
// passport (a passport can have more than one responsible person).
// ─────────────────────────────────────────────

model ObjectInstanceResponsible {
  objectInstanceId String @map("object_instance_id") @db.Uuid
  userId           String @map("user_id") @db.Uuid

  objectInstance ObjectInstance @relation(fields: [objectInstanceId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([objectInstanceId, userId])
  @@map("object_instance_responsible")
}

// ─────────────────────────────────────────────
// TableFieldRow — one row of a TABLE-type field within one passport (e.g.
// one server row in "Состав системы"). `cells` holds that row's values,
// keyed by the field's tableColumns.
// ─────────────────────────────────────────────

model TableFieldRow {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectInstanceId  String   @map("object_instance_id") @db.Uuid
  fieldDefinitionId String   @map("field_definition_id") @db.Uuid
  rowOrder          Int      @default(0) @map("row_order")
  cells             Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  objectInstance  ObjectInstance  @relation(fields: [objectInstanceId], references: [id], onDelete: Cascade)
  fieldDefinition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  // Real relational mirror of any IP_REFERENCE-typed column's value in
  // this row's `cells` — see TableCellIpAddressValue below. onDelete:
  // Cascade here means deleting/recreating this row (the usual
  // "delete-then-recreate" sync on every passport save — see actions.ts)
  // automatically cleans up its old links, no manual delete needed.
  ipAddressLinks TableCellIpAddressValue[]
  // Table-column counterpart of ObjectInstance.objectReferenceLinks — same
  // Cascade reasoning: deleting/recreating this row (the usual
  // "delete-then-recreate" sync on every passport save) cleans these up
  // automatically.
  objectReferenceLinks TableCellObjectReferenceValue[]

  @@index([objectInstanceId])
  @@index([fieldDefinitionId])
  @@map("table_field_rows")
}

// ─────────────────────────────────────────────
// TableCellIpAddressValue — real relational backing for a TABLE column of
// type IP_REFERENCE (26 August 2026), the table-column counterpart of
// FieldIpAddressValue above. Same reasoning: the cell's value (an
// IpAddress id) still lives in TableFieldRow.cells JSON — keeps one
// read/render/CSV path for every column type — but this table mirrors it
// for real referential integrity. Scoped to one column of one row rather
// than one field of one passport, hence a separate model keyed by
// (tableFieldRowId, columnKey) instead of reusing FieldIpAddressValue's
// (objectInstanceId, fieldDefinitionId) key.
// ─────────────────────────────────────────────

model TableCellIpAddressValue {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableFieldRowId String   @map("table_field_row_id") @db.Uuid
  columnKey       String   @map("column_key")
  ipAddressId     String   @map("ip_address_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tableFieldRow TableFieldRow @relation(fields: [tableFieldRowId], references: [id], onDelete: Cascade)
  ipAddress     IpAddress     @relation(fields: [ipAddressId], references: [id], onDelete: Restrict)

  @@unique([tableFieldRowId, columnKey])
  @@index([ipAddressId])
  @@map("table_cell_ip_address_values")
}

// ─────────────────────────────────────────────
// TableCellObjectReferenceValue — table-column counterpart of
// FieldObjectReferenceValue (28 August 2026, CMDB phase 2), exactly the
// way TableCellIpAddressValue is the table-column counterpart of
// FieldIpAddressValue above. One row per (table row, column) pointing at
// exactly one of targetLocation/targetObjectInstance — same CHECK
// constraint as FieldObjectReferenceValue, hand-written in the migration.
// ─────────────────────────────────────────────

model TableCellObjectReferenceValue {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableFieldRowId        String   @map("table_field_row_id") @db.Uuid
  columnKey              String   @map("column_key")
  targetLocationId       String?  @map("target_location_id") @db.Uuid
  targetObjectInstanceId String?  @map("target_object_instance_id") @db.Uuid
  // Table-column counterpart of FieldObjectReferenceValue.relationshipType
  // above (1 September 2026, CMDB phase 6) — copied from the owning
  // column's own relationshipType (TableColumnDef.relationshipType, part of
  // the field's tableColumns JSON) by syncTableCellObjectReferenceLinks.
  relationshipType       RelationshipType? @map("relationship_type")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tableFieldRow        TableFieldRow   @relation(fields: [tableFieldRowId], references: [id], onDelete: Cascade)
  targetLocation       Location?       @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)
  targetObjectInstance ObjectInstance? @relation("TableCellObjectReferenceTarget", fields: [targetObjectInstanceId], references: [id], onDelete: Restrict)

  @@unique([tableFieldRowId, columnKey])
  @@index([targetLocationId])
  @@index([targetObjectInstanceId])
  @@map("table_cell_object_reference_values")
}

// ─────────────────────────────────────────────
// EquipmentTypeCode — admin-managed dictionary of equipment-type codes
// used by AUTO_IDENTIFIER fields (28 August 2026, CMDB phase 3), e.g.
// "cs" = Коммутатор, "srv" = Сервер, per Table 2 of the Kazakhtelecom
// naming standard (ДИТ/И-05-28.2-16). Deliberately its own small table,
// not a rebirth of the OptionList feature that was built and rejected 25
// August 2026 (see it-passports-design.md section 6.4) — OptionList was a
// general, per-SELECT-field reusable list of free-text options that the
// user chose not to keep; this is a single, fixed-purpose dictionary of
// standardised codes that AUTO_IDENTIFIER fields pick from (not a SELECT
// option source at all), seeded from the standard's own Table 2 so it's
// useful out of the box, and open to admin edits if new equipment types
// appear or the standard is revised.
// ─────────────────────────────────────────────

model EquipmentTypeCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique
  label     String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fields              FieldDefinition[]
  autoIdentifierLinks FieldAutoIdentifierValue[]

  @@map("equipment_type_codes")
}

// ─────────────────────────────────────────────
// FieldAutoIdentifierValue — real relational backing + uniqueness guard for
// FieldType.AUTO_IDENTIFIER (28 August 2026, CMDB phase 3). One row per
// (passport, field), recording exactly which rack + equipment-type code +
// sequence number the currently-stored identifier was computed from. The
// UNIQUE constraint on (targetLocationId, equipmentTypeCodeId, seq) is
// what actually prevents two passports from ever ending up with the same
// identifier in the same rack — generateAutoIdentifierValue
// (passports/auto-identifier-utils.ts) computes the next seq via MAX()
// inside the same transaction as the insert, so a concurrent save racing
// for the same (rack, code) pair fails loudly on this constraint rather
// than silently producing a duplicate identifier (see that function's doc
// comment for why a full retry loop was judged not worth the complexity
// at this app's scale — same risk posture as the plain pre-checks used
// elsewhere, e.g. findSibling in locations/actions.ts).
//
// Once generated, an identifier is treated as permanent — see
// syncAutoIdentifierValues's doc comment: unlike every other reference
// type in this app (which delete-then-recreate their mirror row on every
// passport save), a row here is written once and then left alone, even if
// the passport's rack field is edited afterward. Regenerating on every
// save would risk reissuing a seq that's already been physically printed
// on equipment.
//
// onDelete: Restrict on both targetLocation and equipmentTypeCode mirrors
// FieldObjectReferenceValue: neither the rack nor the code can be deleted
// while an identifier still depends on it.
// ─────────────────────────────────────────────

model FieldAutoIdentifierValue {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  objectInstanceId    String   @map("object_instance_id") @db.Uuid
  fieldDefinitionId   String   @map("field_definition_id") @db.Uuid
  targetLocationId    String   @map("target_location_id") @db.Uuid
  equipmentTypeCodeId String   @map("equipment_type_code_id") @db.Uuid
  seq                 Int
  value               String
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz

  objectInstance    ObjectInstance    @relation(fields: [objectInstanceId], references: [id], onDelete: Cascade)
  fieldDefinition   FieldDefinition   @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  targetLocation    Location          @relation(fields: [targetLocationId], references: [id], onDelete: Restrict)
  equipmentTypeCode EquipmentTypeCode @relation(fields: [equipmentTypeCodeId], references: [id], onDelete: Restrict)

  @@unique([objectInstanceId, fieldDefinitionId])
  @@unique([targetLocationId, equipmentTypeCodeId, seq])
  @@index([targetLocationId])
  @@index([equipmentTypeCodeId])
  @@map("field_auto_identifier_values")
}
